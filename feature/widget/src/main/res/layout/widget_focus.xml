<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_phase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:text="@string/widget_phase_focus"
            android:textAllCaps="true"
            android:textColor="#FF8B8B95"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8B8B95"
            android:textSize="11sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/widget_clock"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:countDown="true"
        android:fontFamily="sans-serif-thin"
        android:gravity="center_vertical"
        android:textColor="#FFEDEDF0"
        android:textSize="40sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="#FF8B8B95"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_button"
            android:backgroundTint="#FF4C8DFF"
            android:gravity="center"
            android:minWidth="84dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/widget_start"
            android:textColor="#FF000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
