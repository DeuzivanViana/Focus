<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Usage Access: read which app is in the foreground while a focus runs.
      It is a special app-op: the user grants it in system settings after an
      explanation screen, and it is only used locally (the app has no INTERNET).
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Optional, only for block mode: lets the app bring its block screen to the front. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Only launchable apps are visible, which is all the block list needs. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- Not exported: only this app can open the block screen. -->
        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.focus.block"
            android:theme="@style/Theme.Focus.Block" />
    </application>
</manifest>
